# ==========================================
# AI DJ STUDIO — ENVIRONMENT CONFIGURATION
# ==========================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (Leave blank to use automatic in-memory MongoDB in dev/test)
MONGODB_URI=mongodb://localhost:27017/ai-dj-studio
USE_IN_MEMORY_DB=false

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# AI Engine Configuration
# Supported providers: 'heuristic' (built-in intelligent deterministic fallback), 'openai', 'gemini'
AI_PROVIDER=heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini

# Audio & Upload Settings
MAX_AUDIO_UPLOAD_MB=15
UPLOAD_DIR=./uploads/audio

# Client Environment (Vite)
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
